# Jmall 环境变量模板
# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# MySQL
JMALL_MYSQL_ROOT_PASSWORD=jmall123
JMALL_MYSQL_PORT=3306

# PostgreSQL
JMALL_POSTGRES_USER=postgres
JMALL_POSTGRES_PASSWORD=jmall123
JMALL_POSTGRES_DB=jmall_rag
JMALL_POSTGRES_PORT=5432

# Redis
JMALL_REDIS_PORT=6379

# Grafana
JMALL_GRAFANA_PASSWORD=jmall123

# JWT 密钥（至少 32 字节；生产环境必须替换为随机值）
JMALL_JWT_SECRET=jmall-local-demo-jwt-secret-change-me-2026

# ============ AI 配置（可选，不填则使用 mock 模式）============

# 默认 AI Provider: mock / deepseek / qwen
AI_PROVIDER=mock

# DeepSeek（便宜模型，用于市场调研、合规审查）
JMALL_DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Qwen / 阿里云百炼（中等模型，用于风格适配、质量评估）
JMALL_QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Tavily 搜索 API（市场调研首选；不可用时自动切换到上面的 Qwen 联网搜索）
JMALL_TAVILY_API_KEY=

# Image Scout：复用上面的千问 Key 与 URL，picture_base 指定图片检索模型
IMAGE_SEARCH_PROVIDER=qwen
picture_base=qwen-plus-latest
# 可选：切回 SerpAPI / Google 图片候选
SERPAPI_API_KEY=
JMALL_SERPAPI_API_KEY=

# ============ Agent 分层路由 ============
# strong（决策/文案）→ 建议用最强模型
AGENT_STRONG_PROVIDER=
AGENT_STRONG_MODEL=
# medium（设计/风格）→ 建议用 Qwen
AGENT_MEDIUM_PROVIDER=
AGENT_MEDIUM_MODEL=
# cheap（搜索/合规）→ 建议用便宜模型
AGENT_CHEAP_PROVIDER=
AGENT_CHEAP_MODEL=

# ============ RAG Embedding（使用知识库导入时配置）============
# 当前 pgvector 列维度为 1024，模型输出维度必须与之相同
RAG_EMBEDDING_PROVIDER=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_DIMENSION=1024
