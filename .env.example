# Jmall 环境变量模板
# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# MySQL
JMALL_MYSQL_ROOT_PASSWORD=jmall123
JMALL_MYSQL_PORT=3306

# PostgreSQL
JMALL_POSTGRES_USER=postgres
JMALL_POSTGRES_PASSWORD=jmall123
JMALL_POSTGRES_DB=jmall_rag
JMALL_POSTGRES_PORT=5432

# Redis
JMALL_REDIS_PORT=6379

# Grafana
JMALL_GRAFANA_PASSWORD=jmall123

# JWT 密钥（生产环境请更换）
JMALL_JWT_SECRET=jmall-jwt-secret-key-2024

# ============ AI 配置（可选，不填则使用 mock 模式）============

# 默认 AI Provider: mock / deepseek / qwen
AI_PROVIDER=mock

# DeepSeek（便宜模型，用于市场调研、合规审查）
JMALL_DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Qwen / 阿里云百炼（中等模型，用于风格适配、质量评估）
JMALL_QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Tavily 搜索 API（市场调研首选；不可用时自动切换到上面的 Qwen 联网搜索）
JMALL_TAVILY_API_KEY=

# ============ Agent 分层路由 ============
# strong（决策/文案）→ 建议用最强模型
AGENT_STRONG_PROVIDER=
AGENT_STRONG_MODEL=
# medium（设计/风格）→ 建议用 Qwen
AGENT_MEDIUM_PROVIDER=
AGENT_MEDIUM_MODEL=
# cheap（搜索/合规）→ 建议用便宜模型
AGENT_CHEAP_PROVIDER=
AGENT_CHEAP_MODEL=
