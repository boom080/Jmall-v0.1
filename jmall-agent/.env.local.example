AI_SERVICE_ENV=local
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=18080
AI_SERVICE_API_PREFIX=/api
AI_SERVICE_LOG_LEVEL=INFO

AI_PROVIDER=qwen
AI_MODEL_NAME=qwen3-max
AI_FALLBACK_PROVIDER=mock
AI_TIMEOUT_SECONDS=30
AI_RAG_ENABLED=true
AI_RAG_TOP_K=4
AI_RAG_CACHE_TTL_SECONDS=300

QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=你的百炼APIKey
QWEN_CHAT_MODEL=qwen3-max
QWEN_EMBEDDING_MODEL=text-embedding-v4

IMAGE_SEARCH_PROVIDER=qwen
picture_base=qwen-plus-latest
IMAGE_SEARCH_TIMEOUT_SECONDS=20

DATABASE_URL=postgresql+psycopg://postgres:你的PostgreSQL密码@127.0.0.1:5433/jrunmall_ai
DATABASE_ENGINE=postgresql
MERCHANT_AI_SCHEMA=jrunmall_merchant_ai

RAG_EMBEDDING_PROVIDER=openai-compatible
RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_EMBEDDING_API_KEY=你的百炼APIKey
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSION=1024
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_MIN_SCORE=0.2

REDIS_URL=
MERCHANT_AI_DATA_FILE=data/merchant_ai_store.json
