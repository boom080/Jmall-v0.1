# Jmall Agent 环境变量
# 复制此文件为 .env.local 并填入真实值

AI_SERVICE_ENV=local
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=18080
AI_SERVICE_API_PREFIX=/api
AI_SERVICE_LOG_LEVEL=INFO

# 默认 AI Provider（mock / deepseek / qwen / openai-compatible）
AI_PROVIDER=mock
AI_MODEL_NAME=mock-product-copy-v1
AI_FALLBACK_PROVIDER=mock
AI_TIMEOUT_SECONDS=60
AI_RAG_ENABLED=true
AI_RAG_TOP_K=5
AI_RAG_CACHE_TTL_SECONDS=300

# RAG Embedding
RAG_EMBEDDING_PROVIDER=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_DIMENSION=1024
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_MIN_SCORE=0.2

# DeepSeek（便宜模型）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Qwen / 阿里云百炼
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v4

# Tavily Search（市场调研用）
TAVILY_API_KEY=

# Agent 成本控制
AGENT_DEFAULT_PROVIDER=
AGENT_CHEAP_MODEL=
AGENT_STRONG_MODEL=
# 按 tier 指定 provider（为空则回退到 AGENT_DEFAULT_PROVIDER / AI_PROVIDER）
AGENT_STRONG_PROVIDER=
AGENT_MEDIUM_PROVIDER=
AGENT_CHEAP_PROVIDER=
AGENT_MEDIUM_MODEL=
AGENT_COST_BUDGET_DAILY=5.0
COST_TRACKING_ENABLED=true

# PostgreSQL（Docker 部署时自动配置）
DATABASE_URL=
DATABASE_ENGINE=postgresql
MERCHANT_AI_SCHEMA=jmall_rag
MERCHANT_AI_DATA_FILE=data/merchant_ai_store.json

REDIS_URL=
