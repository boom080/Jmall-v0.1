{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "prometheus", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Today's Cost",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto" },
      "targets": [{ "expr": "agent_cost_daily_usd", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Cost (All Time)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "mode": "continuous-BlPu" }
        }
      },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto" },
      "targets": [{ "expr": "sum(agent_cost_total_usd) or vector(0)", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total API Calls",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto" },
      "targets": [{ "expr": "sum(agent_requests_total) or vector(0)", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Daily Budget Usage",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.6 },
              { "color": "red", "value": 0.9 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "orientation": "horizontal", "showThresholdLabels": true, "showThresholdMarkers": true },
      "targets": [{ "expr": "clamp_max(agent_cost_daily_usd / clamp_min(agent_budget_daily_usd, 0.01), 1)", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cost by Agent Type (rate[5m])",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" }
        }
      },
      "targets": [{ "expr": "rate(agent_cost_total_usd[5m])", "legendFormat": "{{agent_type}}", "refId": "A" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Token Consumption (input vs output)",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never", "stacking": { "mode": "normal" } }
        }
      },
      "targets": [
        { "expr": "rate(agent_tokens_total{direction=\"input\"}[5m])", "legendFormat": "Input Tokens/s", "refId": "A" },
        { "expr": "rate(agent_tokens_total{direction=\"output\"}[5m])", "legendFormat": "Output Tokens/s", "refId": "B" }
      ]
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Requests by Agent Type",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } }
      },
      "targets": [{ "expr": "sum(agent_requests_total) by (agent_type)", "legendFormat": "{{agent_type}}", "refId": "A" }]
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "Tokens by Agent Type",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 14 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }
      },
      "targets": [{ "expr": "sum(agent_tokens_total) by (agent_type)", "legendFormat": "{{agent_type}}", "refId": "A" }]
    },
    {
      "id": 9,
      "type": "heatmap",
      "title": "Request Duration Distribution (seconds)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "targets": [{ "expr": "sum(rate(agent_request_duration_seconds_bucket[5m])) by (le)", "format": "heatmap", "legendFormat": "{{le}}", "refId": "A" }]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["jmall", "agent", "ai"],
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Jmall Agent - LLM Cost Dashboard",
  "uid": "jmall-agent-cost",
  "version": 1,
  "weekStart": "monday"
}
