{
  "uid": "jmall-v02-product-funnel",
  "title": "Jmall v0.2 产品漏斗",
  "description": "浏览器会话阶段只在当前后端进程周期累计，每次进入编辑页是新会话，不是用户UV；重启会清零。客户端上报可能丢失，不代替服务端发布审计。无样本显示空值，不伪造转化率。",
  "tags": [
    "jmall",
    "v0.2",
    "product"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "编辑 → 保存草稿（进程周期）",
      "description": "浏览器会话阶段只在当前后端进程周期累计，每次进入编辑页是新会话，不是用户UV；重启会清零。客户端上报可能丢失，不代替服务端发布审计。无样本显示空值，不伪造转化率。",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "暂无样本"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jmall_editor_sessions_total{stage=\"draft_saved\"}) / sum(jmall_editor_sessions_total{stage=\"editor_opened\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "草稿 → 发布（进程周期）",
      "description": "浏览器会话阶段只在当前后端进程周期累计，每次进入编辑页是新会话，不是用户UV；重启会清零。客户端上报可能丢失，不代替服务端发布审计。无样本显示空值，不伪造转化率。",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "暂无样本"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jmall_editor_sessions_total{stage=\"published\"}) / sum(jmall_editor_sessions_total{stage=\"draft_saved\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "无图 → 选图或上传（进程周期）",
      "description": "浏览器会话阶段只在当前后端进程周期累计，每次进入编辑页是新会话，不是用户UV；重启会清零。客户端上报可能丢失，不代替服务端发布审计。无样本显示空值，不伪造转化率。",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "暂无样本"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jmall_editor_sessions_total{stage=\"image_resolved\"}) / sum(jmall_editor_sessions_total{stage=\"no_image\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "编辑会话阶段（累计）",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (jmall_editor_sessions_total)",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "服务端保存 / 发布事件（每分钟）",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event) (rate(jmall_product_events_total[$__rate_interval])) * 60",
          "legendFormat": "{{event}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "输入检查结果（每分钟，含复检）",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (entrypoint, outcome) (rate(jmall_input_assessments_total[$__rate_interval])) * 60",
          "legendFormat": "{{entrypoint}} / {{outcome}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "生成启动与终态（每分钟，不按 SSE 事件累计）",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (entrypoint, outcome) (rate(jmall_generation_runs_total[$__rate_interval])) * 60",
          "legendFormat": "{{entrypoint}} / {{outcome}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "输入检查 P95（仅计算部分）",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, entrypoint) (rate(jmall_input_assessment_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{entrypoint}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "首个进度回调 P95（Agent 内部，不含公网）",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, platform) (rate(jmall_generation_first_progress_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{platform}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "图片检索 P95（排除输入不足）",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(image_search_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "平台草稿版本与降级（累计）",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (platform, metadata, fallback) (jmall_platform_drafts_total)",
          "legendFormat": "{{platform}} / {{metadata}} / fallback={{fallback}}"
        }
      ]
    }
  ]
}
